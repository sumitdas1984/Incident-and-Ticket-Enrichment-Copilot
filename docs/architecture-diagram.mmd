    class UI,ChatClient,TicketClient gui
    class Routes,Planner,Chain,MCPClientA,MCPClientT,RagStep,Conv orchestrator
    class AlarmMCP,TicketMCP mcp
    class AlarmAPI,TicketMock connector
    class Ingest,Retrieve,Injection rag
    class Domain,Config,Logging foundation
    class VarIdx,ConvMem persistence
    class Tests tests