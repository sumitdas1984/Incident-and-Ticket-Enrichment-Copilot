# --- Required placeholders (Submission_and_Evaluation_Guidelines.md section 10) ---

ALARM_API_BASE_URL=http://localhost:8000
ALARM_API_TOKEN=replace-me

# Optional Alarm API retry tuning (Feature 3.3 — Story 3.3.1).
# Defaults shown; uncomment to override.
# Per-request timeout in seconds (connect/read/write/pool).
# ALARM_API_TIMEOUT_S=5.0
# Total attempts including the first one. 1 disables retries.
# ALARM_API_MAX_ATTEMPTS=3
# Exponential-backoff bounds. With the defaults below, waits
# between attempts are roughly 0.25 s, 0.5 s, ... capped at 2 s
# with ±10 % jitter.
# ALARM_API_INITIAL_BACKOFF_S=0.25
# ALARM_API_MAX_BACKOFF_S=2.0

MCP_SERVER_URL=http://localhost:9000

# Embedder backend used by the orchestrator at query time.
# Must match the embedder that built the persisted index
# (set via `python -m rag.ingestion --embedder <name>`).
# The default is deterministic so the demo is hermetic.
EMBEDDER_BACKEND=deterministic

LLM_PROVIDER=mock
LLM_API_KEY=replace-me

VECTOR_STORE_URL=http://localhost:8002
DOCUMENT_PATH=./rag/documents

TICKETING_API_URL=http://localhost:8003

# --- Port overrides (optional) ---
ALARM_API_PORT=8000
MCP_SERVER_PORT=9000
BACKEND_PORT=8001
FRONTEND_PORT=5173
VECTOR_STORE_PORT=8002
TICKETING_API_PORT=8003

# --- GUI ---
# The URL the Streamlit GUI POSTs ``/chat`` to (Feature 7.1,
# Story 7.1.2). Default targets a local dev backend. The
# docker-compose ``frontend`` service overrides this to
# ``http://copilot-backend:8000`` so the in-container GUI reaches
# the backend over the compose network.
COPILOT_BACKEND_URL=http://localhost:8000